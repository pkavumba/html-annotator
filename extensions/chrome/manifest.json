{
  "manifest_version": 3,
  "name": "HTML Annotator",
  "version": "0.1.0",
  "description": "Select text on webpages and save private annotations.",
  "minimum_chrome_version": "110",
  "action": {
    "default_title": "Toggle annotations"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
