{
  "name": "html-annotator",
  "version": "0.2.0",
  "description": "Annotation for the html content.",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkavumba/html-annotator.git"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "backbone-extend-standalone": "^0.1.2",
    "es6-promise": "^4.2.8",
    "insert-css": "^2.0.0",
    "jquery": "^3.7.1",
    "markdown-it": "^15.0.0",
    "simple-xpath-position": "^2.0.2",
    "xpath-range": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chai": "^6.2.2",
    "connect": "^3.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "fake-xml-http-request": "^2.1.2",
    "jsdom": "^30.0.1",
    "jwt-simple": "^0.5.6",
    "prettier": "^3.9.6",
    "serve-static": "^2.2.1",
    "sinon": "^22.1.0",
    "terser": "^5.50.0",
    "vitest": "^4.1.10",
    "wgxpath": "^1.1.0"
  },
  "scripts": {
    "build": "make",
    "clean": "make clean",
    "serve": "./tools/serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test tools/serve browser.js index.js",
    "format": "prettier --write package.json README.md",
    "format:check": "prettier --check package.json README.md",
    "check": "npm run lint && npm test && npm run build"
  },
  "main": "index.js",
  "browser": "browser.js",
  "exports": {
    ".": {
      "require": "./index.js",
      "default": "./index.js"
    },
    "./browser": "./browser.js",
    "./package.json": "./package.json"
  },
  "files": [
    "browser.js",
    "css",
    "img",
    "index.js",
    "locale",
    "pkg",
    "src"
  ]
}
